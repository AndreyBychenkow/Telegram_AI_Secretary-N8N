# Copy to .env (git-ignored) and fill in. Never commit real values.

# Telegram & Groq (required)
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
# Generated automatically by deploy script if empty
WEBHOOK_SECRET=

# Optional overrides
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
TIMEZONE=Europe/Moscow

# Optional Google integration (service account). Without it tasks/logs/events are kept in SQLite.
# Local path to the service account JSON key; deploy uploads it to PythonAnywhere.
GOOGLE_SERVICE_ACCOUNT_LOCAL_FILE=
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=primary

# PythonAnywhere deploy (used only by deploy/deploy_pythonanywhere.py, not uploaded)
PA_USERNAME=decebell032rus
PA_HOST=www.pythonanywhere.com
PA_API_TOKEN=
# Used only by deploy/renew_pythonanywhere.py (local run); in CI it is a GitHub secret
PA_PASSWORD=
