# Порт и протокол n8n
PORT=5678
N8N_PORT=5678
N8N_PROTOCOL=https

# На Render.com переменные RENDER_EXTERNAL_HOSTNAME и RENDER_EXTERNAL_URL
# подставляются в N8N_HOST и WEBHOOK_URL автоматически через docker-entrypoint.sh.
# При ручном запуске укажите свой домен:
# N8N_HOST=telegram-ai-secretary-n8n.onrender.com
# WEBHOOK_URL=https://telegram-ai-secretary-n8n.onrender.com/

# Часовой пояс (для Google Calendar и дат задач)
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Разрешить использование $env.GROQ_API_KEY внутри нод workflow
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Ключ шифрования учётных данных n8n (любая случайная строка 32+ символов)
N8N_ENCRYPTION_KEY=replace_with_random_32_char_secret_key

# API-ключ Groq (используется в HTTP Request ноде для Whisper)
GROQ_API_KEY=gsk_replace_with_your_groq_api_key

# Опционально: подключение внешней PostgreSQL БД (например, Neon.tech / Supabase),
# чтобы на бесплатном тарифе Render учётные данные не сбрасывались при перезапуске контейнера:
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=ep-xxx.eu-central-1.aws.neon.tech
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=neondb
# DB_POSTGRESDB_USER=neondb_owner
# DB_POSTGRESDB_PASSWORD=your_password
# DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
