    {
      "parameters": {
        "jsCode": "const meta = $('Определить команду').first().json;\nconst agentOut = $input.first().json;\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n      chat_id: meta.chat_id,\n      user_id: meta.user_id,\n      username: meta.username,\n      input_type: meta.input_type,\n      user_message: meta.userText,\n      assistant_reply: agentOut.output || '',\n      calendar_command: meta.calendar_command || 'no'\n    }\n  }\n];"
      },
